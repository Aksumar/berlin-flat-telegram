KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=berlin-flat-listings-v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Personal subscriptions: /start opens setup; saving the search enables alerts.
# Only one application instance may poll updates for this bot.
TELEGRAM_UPDATES_ENABLED=true
SUBSCRIPTIONS_DATABASE_URL=jdbc:h2:file:./data/subscriptions
KAFKA_GROUP_ID=berlin-flat-telegram-v1

# Optional: enables map images
GEOAPIFY_API_KEY=
